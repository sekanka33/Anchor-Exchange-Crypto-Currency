DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=anchor_exchange

JWT_SECRET=

FRONTEND_URL=http://localhost:5173
PORT=5000

# Email (SMTP). If left blank, emails are logged to the server console instead
# of sent (demo mode) so verification/reset flows still work without a real
# mail provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Anchor Exchange <no-reply@anchorexchange.com>

# Market data (CoinGecko demo key) — kept server-side only, never exposed to the browser.
COINGECKO_API_KEY=

# Payment provider (demo mode when unset — every card/bank charge and fiat
# deposit is simulated). PAYMENT_WEBHOOK_SECRET signs/verifies the demo
# webhook callbacks in that mode and should still be set to a real random
# value even in demo mode.
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=

# Seeds the deterministic demo crypto deposit addresses (Stage 9) — set to a
# real random value; falls back to an insecure hardcoded default if unset.
CRYPTO_ADDRESS_SECRET=
