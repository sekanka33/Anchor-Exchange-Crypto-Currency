DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=anchor_exchange

JWT_SECRET=

FRONTEND_URL=http://localhost:5173
PORT=5000

# Email (SMTP). If left blank, emails are logged to the server console instead
# of sent (demo mode) so verification/reset flows still work without a real
# mail provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Anchor Exchange <no-reply@anchorexchange.com>

# Market data (CoinGecko demo key) — kept server-side only, never exposed to the browser.
COINGECKO_API_KEY=

# --- Money integrations -----------------------------------------------------
# Only the "demo" adapters exist in this build (services/payments,
# services/custody): no real money or crypto moves. Unset = demo. Any other
# name fails at startup until that adapter is implemented — the app never
# falls back to simulation silently. See README "Activating real payments".
PAYMENT_PROVIDER=
CUSTODY_PROVIDER=

# HMAC secrets that authenticate provider callbacks to /api/webhooks/payments
# and /api/webhooks/custody. Each must be its OWN random value (never reuse one
# for the other): openssl rand -hex 32. At least 32 characters; published
# defaults and low-variety values are rejected. Required in production; in
# development an unset value falls back to a labelled, public dev value.
PAYMENT_WEBHOOK_SECRET=
CUSTODY_WEBHOOK_SECRET=

# Seeds the deterministic DEMO crypto deposit addresses (openssl rand -hex 32).
# Issued addresses are stored, so changing it only affects new addresses.
CRYPTO_ADDRESS_SECRET=

# AES-256-GCM key for bank account numbers at rest: exactly 32 bytes, as 64
# hex characters (openssl rand -hex 32) or 44-character base64
# (openssl rand -base64 32). Required in production. Keep it in your secret
# manager: replacing it without a rotation makes saved beneficiaries
# permanently unreadable.
BENEFICIARY_ENCRYPTION_KEY=

# Only during a key rotation: the OLD key, so existing rows stay readable while
# scripts/rotateBeneficiaryKey.js re-encrypts them. Remove once it has run.
# BENEFICIARY_ENCRYPTION_KEY_PREVIOUS=

# Seconds the demo provider/custodian wait before sending each callback, and
# how long to wait for any provider call before treating the outcome as unknown.
# DEMO_EVENT_DELAY_MS=1500
# PROVIDER_TIMEOUT_MS=15000

# --- Runtime / deployment ---------------------------------------------------
# development (default) | production. In production the server REFUSES to start
# unless the checks in config/validateEnv.js pass (SMTP configured, FRONTEND_URL
# is the public URL, strong and distinct webhook/address secrets, a valid
# beneficiary key, a strong JWT_SECRET). Passing them does NOT make real-money
# operation possible: only demo adapters exist.
NODE_ENV=development

# The exchange has no real payment provider or blockchain integration, so all
# payments/deposits are simulated. In production that must be acknowledged
# explicitly with the literal value "true"; without it the server won't boot.
# ALLOW_DEMO_MODE=true

# Number of reverse-proxy hops in front of the app (e.g. 1 behind nginx). Needed
# for per-IP rate limiting to see real client IPs. Leave unset if not proxied.
# TRUST_PROXY=1

# Redis (QR login sessions). REDIS_URL wins if set; otherwise host/port.
# REDIS_URL=redis://user:pass@host:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Tests (optional). Backend + E2E tests use a throwaway database recreated on
# every run; its name MUST end in _test or the test helpers refuse to run.
# TEST_DB_NAME=anchor_exchange_test
